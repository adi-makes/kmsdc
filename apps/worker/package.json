{
  "name": "@kmsdc/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kottakal Clinic background worker (BullMQ: outbox relay, automation, scheduled jobs)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@kmsdc/config": "workspace:*",
    "@kmsdc/types": "workspace:*",
    "bullmq": "6.7.5",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
