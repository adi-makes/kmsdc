# =====================================================================
# Kottakal Clinic — environment variables (LOCAL DEVELOPMENT TEMPLATE)
#
#   pnpm env:init              (creates .env with random local secrets)
#   or: cp .env.example .env
#
# NEVER commit .env. This repository is public. Values below are
# placeholders for local Docker services only — not real credentials.
# =====================================================================

NODE_ENV=development
LOG_LEVEL=info
CLINIC_TIMEZONE=Asia/Kolkata

# ---- Docker infrastructure (docker-compose.yml) ----------------------
POSTGRES_USER=kmsdc
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=kmsdc
POSTGRES_PORT=5442
REDIS_PORT=6389
MINIO_ROOT_USER=kmsdc-minio
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MAILPIT_SMTP_PORT=1035
MAILPIT_UI_PORT=8035

# ---- Connection strings used by api + worker ------------------------
DATABASE_URL=postgresql://kmsdc:change-me-local-only@localhost:5442/kmsdc
TEST_DATABASE_URL=postgresql://kmsdc:change-me-local-only@localhost:5442/kmsdc_test
REDIS_URL=redis://localhost:6389

# ---- Object storage (MinIO locally; any S3-compatible API in cloud) --
S3_ENDPOINT=http://localhost:9010
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=kmsdc-minio
S3_SECRET_ACCESS_KEY=change-me-local-only
S3_BUCKET_PRIVATE=kmsdc-private
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300

# ---- API (NestJS) ----------------------------------------------------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# At least 32 random characters. `pnpm env:init` generates one.
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
SESSION_IDLE_TIMEOUT_MINUTES=720
SESSION_ABSOLUTE_TIMEOUT_HOURS=168
# true only behind HTTPS (hosted environments)
COOKIE_SECURE=false
ENABLE_SWAGGER=true
TRUST_PROXY=false

# ---- Worker ----------------------------------------------------------
WORKER_HEALTH_PORT=4001
WORKER_CONCURRENCY=5
# Safety switch: real messages are never sent unless this is true AND live
# provider credentials are configured. Keep false in development.
ALLOW_LIVE_SENDS=false

# ---- Web (Next.js) ---------------------------------------------------
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
